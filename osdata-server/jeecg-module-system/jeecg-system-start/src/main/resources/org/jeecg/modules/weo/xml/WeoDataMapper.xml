<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.weo.mapper.WeoDataMapper">

    <!--
        面板数据查询(t_weo_data走联合唯一索引uk_obs_unique(country_code, indicator_code, year)):
        WHERE条件 country_code IN + indicator_code IN + year范围 完整匹配联合索引, 走索引range扫描, 禁止全表扫描
        ORDER BY与索引序一致, 无filesort; LIMIT maxRows防止大结果集OOM(截断由service层判断)
    -->
    <select id="queryPanelDataRows" resultType="org.jeecg.modules.weo.entity.WeoData">
        SELECT
            d.country_code AS countryCode,
            d.indicator_code AS indicatorCode,
            d.year AS year,
            d.`value` AS value
        FROM t_weo_data d
        WHERE d.country_code IN
        <foreach collection="countryCodes" item="cc" open="(" separator="," close=")">
            #{cc}
        </foreach>
        AND d.indicator_code IN
        <foreach collection="indicatorCodes" item="ic" open="(" separator="," close=")">
            #{ic}
        </foreach>
        <if test="startYear != null">
            AND d.year &gt;= #{startYear}
        </if>
        <if test="endYear != null">
            AND d.year &lt;= #{endYear}
        </if>
        ORDER BY d.country_code, d.indicator_code, d.year
        LIMIT #{maxRows}
    </select>
</mapper>
